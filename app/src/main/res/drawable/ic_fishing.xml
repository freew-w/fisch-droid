<?xml version="1.0" encoding="utf-8"?>
<!--
  "Rod control" section icon: a bowed rod, a thin line off the tip, and a fish hook.

  Redrawn from the previous glyph, which had two defects: a stray r=0.7 dot floating at
  (16, 4.2) detached from every other path, and a solid r=1.8 blob sitting on the line
  where it crossed the rod, so it read as a knot rather than a bobber. The old hook also
  curled back inside itself, which at 1.6-unit stroke closes up into a spiral/blob at 24dp.

  Geometry: hook = shank down to y 14.7, a 180-degree bend (r 2.6), point rising to y 12.7
  with a ~3.5-unit mouth, so it stays open at 24dp instead of fusing. Weights are
  deliberately unequal (rod 2.1, line 1.5, hook 1.6) so the eye separates the rod from the
  line it carries; with equal weights the three strokes merged into one zigzag.
  The hook bend dips lower than its control points imply (a 2.6-radius cubic bottoms out at
  y 20.3), so the whole glyph is offset by (+0.6, -0.9) to sit on the grid: ink occupies
  x 3.0-20.9, y 3.4-20.6, i.e. ~3 units of padding on every side.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M4.1,19.6 C5.5,15.3 7.8,9.4 11.5,4.5"
        android:strokeWidth="2.1"
        android:strokeColor="?attr/colorOnSurface"
        android:strokeLineCap="round" />
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M11.5,4.5 C13.9,5.7 14.9,8.3 14.9,10.6 L14.9,11.5"
        android:strokeWidth="1.5"
        android:strokeColor="?attr/colorOnSurface"
        android:strokeLineCap="round" />
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M14.9,11.5 L14.9,13.8 C14.9,16.4 20.1,16.4 20.1,13.8 L19.8,11.8"
        android:strokeWidth="1.6"
        android:strokeColor="?attr/colorOnSurface"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
