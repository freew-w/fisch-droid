<!--
  Adaptive-icon background: flat sea blue (md_primary) with a water line.

  The wave crest sits at y ~80 so it clears the fish (which ends at y 70) and lands near
  the bottom edge of the visible masked area, reading as water rather than a bright band
  under the icon's subject. 12% white keeps it a texture, not a second colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00658F"
        android:pathData="M0,0h108v108h-108z" />
    <path
        android:fillColor="#1FFFFFFF"
        android:pathData="M0,80 C20,73 34,87 54,80 C74,73 88,86 108,79 V108 H0 Z" />
</vector>
