<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_setup_zoom_out"
        style="@style/Widget.FischDroid.NudgeButton"
        android:layout_width="@dimen/nudge_button"
        android:layout_height="@dimen/nudge_button"
        android:contentDescription="@string/setup_zoom_out"
        app:icon="@drawable/ic_zoom_out" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginEnd="@dimen/space_m"
        android:text="@string/setup_zoom_label"
        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_setup_zoom_in"
        style="@style/Widget.FischDroid.NudgeButton"
        android:layout_width="@dimen/nudge_button"
        android:layout_height="@dimen/nudge_button"
        android:contentDescription="@string/setup_zoom_in"
        app:icon="@drawable/ic_zoom_in" />
</LinearLayout>
