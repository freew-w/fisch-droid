<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusableInTouchMode="true"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btnEnable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enable_accessibility_service" />

    <Button
        android:id="@+id/btnCapture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/start_screen_capture" />

    <Button
        android:id="@+id/btnStopCapture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stop_screen_capture" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rod control:" />

        <EditText
            android:id="@+id/rodControl"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:text="0.0" />

    </LinearLayout>

</androidx.appcompat.widget.LinearLayoutCompat>